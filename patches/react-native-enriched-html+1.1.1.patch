diff --git a/node_modules/react-native-enriched-html/ios/styles/BlockQuoteStyle.mm b/node_modules/react-native-enriched-html/ios/styles/BlockQuoteStyle.mm
index 8146d2e..00b711a 100644
--- a/node_modules/react-native-enriched-html/ios/styles/BlockQuoteStyle.mm
+++ b/node_modules/react-native-enriched-html/ios/styles/BlockQuoteStyle.mm
@@ -77,4 +77,31 @@
   }
 }
 
+// Without this a blockquote has no way to be exited: typing attributes
+// carry the quote styling across every newline forever, so the default
+// UITextView newline handling alone never breaks out of it. Pressing return
+// on an already-empty quote line clears the quote styling for that same
+// line instead of inserting another quoted line — matches the same pattern
+// CheckboxListStyle/HeadingStyleBase use to let return "exit" their block.
+- (BOOL)handleNewlinesInRange:(NSRange)range replacementText:(NSString *)text {
+  if ([self detect:self.host.textView.selectedRange] && text.length > 0 &&
+      [[NSCharacterSet newlineCharacterSet]
+          characterIsMember:[text characterAtIndex:text.length - 1]]) {
+    NSString *string = self.host.textView.textStorage.string;
+    NSRange paragraphRange =
+        [string paragraphRangeForRange:self.host.textView.selectedRange];
+    NSString *paragraphText = [string substringWithRange:paragraphRange];
+    NSString *trimmed = [paragraphText
+        stringByTrimmingCharactersInSet:
+            [NSCharacterSet characterSetWithCharactersInString:@"\u200B\n"]];
+    if (trimmed.length == 0) {
+      // Swallow the return entirely — no newline inserted, just drop the
+      // quote styling for the (still empty) current paragraph.
+      [self remove:paragraphRange withDirtyRange:YES];
+      return YES;
+    }
+  }
+  return NO;
+}
+
 @end
